# ──────────────────────────────────────────────────────────────────

### DELETE /api/books/{id} - 도서 삭제
DELETE {{baseUrl}}/api/books/{{bookId}}

> {%
client.test("도서 삭제 성공", function() {
    client.assert(response.status === 204, "상태 코드가 204이어야 합니다");
});
%}

###

### DELETE /api/books/{id} - 존재하지 않는 도서 삭제 (404)
DELETE {{baseUrl}}/api/books/999999

> {%
client.test("존재하지 않는 도서 삭제 - 404", function() {
    client.assert(response.status === 404, "상태 코드가 404이어야 합니다");
});
%}

